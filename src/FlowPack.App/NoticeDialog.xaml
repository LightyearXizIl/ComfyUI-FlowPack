<Window x:Class="FlowPack.App.NoticeDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="520" SizeToContent="Height" MaxHeight="520" WindowStartupLocation="CenterOwner"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
 Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="{DynamicResource BodyFontSize}"
 AutomationProperties.AutomationId="Notice.Dialog" KeyboardNavigation.TabNavigation="Cycle">
 <Border Style="{StaticResource Card}" Padding="0">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Padding="24,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
    <TextBlock Text="{Binding Title,RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
   </Border>
   <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" MaxHeight="280" Margin="24,20,24,20">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="22"/>
   </ScrollViewer>
   <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
    <Button x:Name="CloseButton" Content="知道了" IsCancel="True" IsDefault="True" Click="CloseNotice" Style="{StaticResource StandardActionButton}" HorizontalAlignment="Right" AutomationProperties.AutomationId="Notice.Close"/>
   </Border>
  </Grid>
 </Border>
</Window>
