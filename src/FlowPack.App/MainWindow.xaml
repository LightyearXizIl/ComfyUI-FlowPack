<Window x:Class="FlowPack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:local="clr-namespace:FlowPack.App"
        xmlns:views="clr-namespace:FlowPack.App.Views"
        Title="ComfyUI FlowPack"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Icon="Assets/FlowPack.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}">
  <Window.Resources>
    <DataTemplate x:Key="HomePageTemplate"><views:HomeView /></DataTemplate>
    <DataTemplate x:Key="LibraryPageTemplate"><views:LibraryView /></DataTemplate>
    <DataTemplate x:Key="PackagingPageTemplate"><views:PackageWizardView /></DataTemplate>
    <DataTemplate x:Key="InstallPageTemplate"><views:InstallView /></DataTemplate>
    <DataTemplate x:Key="TasksPageTemplate"><views:TasksView /></DataTemplate>
    <DataTemplate x:Key="SettingsPageTemplate"><views:SettingsView /></DataTemplate>

    <Style x:Key="NavButtonBase" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="MinHeight" Value="80" />
      <Setter Property="Padding" Value="14,24,14,18" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,3" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="NavBorder" Property="Opacity" Value="0.68" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="NavBorder" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HomeNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsHomeContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LibraryNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsLibraryContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PackagingNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPackagingContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="InstallNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsInstallContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TasksNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsTasksContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootLayout">
    <Grid.RowDefinitions>
      <RowDefinition Height="80" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="52,0">
        <StackPanel x:Name="BrandArea"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    MaxWidth="220">
          <Image Source="Assets/Logo.png"
                 Width="32"
                 Height="32"
                 Margin="0,0,10,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="FlowPack"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="COMFYUI RESOURCE TOOL"
                       FontSize="9"
                       Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="PrimaryNavigation"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Panel.ZIndex="2"
                    automation:AutomationProperties.AutomationId="PrimaryNavigation">
          <Button Content="{Binding Text[Nav.Home]}"
                   Style="{StaticResource HomeNavButton}"
                   Command="{Binding NavigateCommand}"
                   CommandParameter="Home" />
          <Button Content="{Binding Text[Nav.Library]}"
                  Style="{StaticResource LibraryNavButton}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Library" />
          <Button Content="{Binding Text[Nav.Packaging]}"
                  Style="{StaticResource PackagingNavButton}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Packaging" />
          <Button Content="{Binding Text[Nav.Install]}"
                  Style="{StaticResource InstallNavButton}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Install" />
          <Button Content="{Binding Text[Nav.Tasks]}"
                  Style="{StaticResource TasksNavButton}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Tasks" />
        </StackPanel>

        <StackPanel x:Name="StatusArea"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    MaxWidth="260">
          <Border Style="{StaticResource StatusBadge}"
                  Margin="0,0,12,0"
                  MaxWidth="196"
                  ToolTip="{Binding StatusNotice}">
            <TextBlock Text="{Binding StatusNotice}"
                       Foreground="{DynamicResource WarningBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </Border>
          <Button Content="⚙"
                  Style="{StaticResource IconButton}"
                  ToolTip="{Binding Text[Nav.Settings]}"
                  FontSize="18"
                  automation:AutomationProperties.Name="{Binding Text[Nav.Settings]}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Settings" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
      <ContentControl x:Name="PageHost"
                      Margin="52,42,52,52"
                      Content="{Binding}"
                      automation:AutomationProperties.AutomationId="PageHost">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource HomePageTemplate}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Library"><Setter Property="ContentTemplate" Value="{StaticResource LibraryPageTemplate}" /></DataTrigger>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Packaging"><Setter Property="ContentTemplate" Value="{StaticResource PackagingPageTemplate}" /></DataTrigger>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Install"><Setter Property="ContentTemplate" Value="{StaticResource InstallPageTemplate}" /></DataTrigger>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Tasks"><Setter Property="ContentTemplate" Value="{StaticResource TasksPageTemplate}" /></DataTrigger>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Settings"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPageTemplate}" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </ScrollViewer>
  </Grid>
</Window>
