<Window x:Class="FlowPack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:local="clr-namespace:FlowPack.App"
        xmlns:views="clr-namespace:FlowPack.App.Views"
        Title="ComfyUI FlowPack"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Icon="Assets/FlowPack.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="{DynamicResource BodyFontSize}"
        AllowDrop="True" PreviewDragOver="OnFileDragOver" Drop="OnFileDrop">
  <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseSecondaryPanelCommand}"/></Window.InputBindings>
  <Window.Resources>
    <DataTemplate x:Key="HomePageTemplate"><views:HomeView /></DataTemplate>
    <DataTemplate x:Key="LibraryPageTemplate"><views:LibraryView /></DataTemplate>
    <DataTemplate x:Key="PackagingPageTemplate"><views:PackageWizardView /></DataTemplate>
    <DataTemplate x:Key="InstallPageTemplate"><views:InstallView /></DataTemplate>
    <DataTemplate x:Key="SettingsPageTemplate"><views:SettingsView /></DataTemplate>
    <DataTemplate x:Key="SecondaryPageTemplate"><views:SecondaryDetailsView /></DataTemplate>
    <Style x:Key="SecondaryBackground" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding IsSecondaryPanelOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>

    <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NavButtonBase" TargetType="Button" BasedOn="{StaticResource NavigationButton}"/>

    <Style x:Key="HomeNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsHomeContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LibraryNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsLibraryContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PackagingNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPackagingContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="InstallNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsInstallContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TasksNavButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsTasksContext}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootLayout">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" /><RowDefinition Height="Auto"/>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
             Style="{StaticResource SecondaryBackground}"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <StackPanel x:Name="BrandArea"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    MaxWidth="220">
          <Image Source="Assets/Logo.png"
                 Width="32"
                 Height="32"
                 Margin="0,0,10,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="FlowPack"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="COMFYUI RESOURCE TOOL"
                       FontSize="9"
                       Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="PrimaryNavigation"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Panel.ZIndex="2"
                    automation:AutomationProperties.AutomationId="PrimaryNavigation">
          <Button Content="{Binding Text[Nav.Home]}"
                   Style="{StaticResource HomeNavButton}"
                   Command="{Binding NavigateCommand}"
                   CommandParameter="Home" />
          <Button Content="{Binding Text[Nav.Library]}"
                  Style="{StaticResource LibraryNavButton}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Library" />
          <Button Content="{Binding Text[Nav.Install]}"
                  Style="{StaticResource InstallNavButton}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Install" />
        </StackPanel>

        <StackPanel x:Name="StatusArea"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    MaxWidth="300">
          <Grid Width="156" Margin="0,0,8,0">
          <ComboBox ItemsSource="{Binding DesktopInstances}"
                    SelectedItem="{Binding SelectedInstance}" DisplayMemberPath="DisplayName"
                    IsEnabled="{Binding CoreReady}" ToolTip="{Binding InstancePaths}"
                    automation:AutomationProperties.Name="选择 Desktop 实例" />
          <TextBlock Text="选择实例" Margin="10,0,30,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedInstance}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          </Grid>
          <Button Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                  Style="{StaticResource SettingsButton}"
                  ToolTip="{Binding Text[Nav.Settings]}"
                  FontSize="18"
                  automation:AutomationProperties.Name="{Binding Text[Nav.Settings]}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Settings" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="32,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SecondaryBackground}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OperationVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding OperationText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OperationText}" VerticalAlignment="Center" AutomationProperties.AutomationId="Operation.Text"/>
      <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding OperationPercent,Mode=OneWay}" IsIndeterminate="{Binding OperationIndeterminate}" Height="6" Margin="20,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="当前阶段进度"/>
      <WrapPanel Grid.Column="2"><Button Content="取消" Command="{Binding CancelOperationCommand}" Margin="0,0,8,0"/><Button Content="收起" Command="{Binding DismissOperationCommand}"/></WrapPanel>
     </Grid>
    </Border>
      <ContentControl x:Name="PageHost" Grid.Row="2"
                      Margin="32,28,32,24"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      Content="{Binding}"
                      automation:AutomationProperties.AutomationId="PageHost">
        <ContentControl.Style>
          <Style TargetType="ContentControl" BasedOn="{StaticResource SecondaryBackground}">
            <Setter Property="ContentTemplate" Value="{StaticResource HomePageTemplate}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Library"><Setter Property="ContentTemplate" Value="{StaticResource LibraryPageTemplate}" /></DataTrigger>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Packaging"><Setter Property="ContentTemplate" Value="{StaticResource PackagingPageTemplate}" /></DataTrigger>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Install"><Setter Property="ContentTemplate" Value="{StaticResource InstallPageTemplate}" /></DataTrigger>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Settings"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPageTemplate}" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
      <Grid x:Name="SecondaryOverlay" Grid.RowSpan="3" Panel.ZIndex="20">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSecondaryPanelOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Border x:Name="SecondaryBackdrop" Background="#80000000" MouseLeftButtonDown="OnSecondaryBackdropMouseDown"/>
        <ContentControl x:Name="SecondaryPanelHost" Content="{Binding}" Width="640" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="24">
          <ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><DataTrigger Binding="{Binding IsSecondaryPanelOpen}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource SecondaryPageTemplate}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style>
        </ContentControl>
      </Grid>
  </Grid>
</Window>
