<UserControl x:Class="FlowPack.App.Views.AboutAuthorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="Settings.About">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Source="/ComfyUI.FlowPack;component/Assets/Logo.png" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="ComfyUI FlowPack" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Margin="0,6,0,0"><Run Text="作者："/><Run Text="{Binding AuthorName,Mode=OneWay}" FontWeight="SemiBold"/>
            <Run Text="   ·   版本 "/><Run Text="{Binding ApplicationVersion,Mode=OneWay}"/></TextBlock>
        </StackPanel>
      </Grid>
      <TextBlock Text="FlowPack 是面向 Windows x64 ComfyUI Desktop 的工作流资源管理与打包工具。" Style="{StaticResource SubtleText}" Margin="0,16,0,24"/>
      <TextBlock Text="GitHub 仓库" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0">
          <Hyperlink Command="{Binding OpenRepositoryCommand}" Foreground="{DynamicResource AccentBrush}" ToolTip="{Binding RepositoryUrl}"
                     AutomationProperties.Name="打开 LightyearXizIl 的 GitHub 仓库"><Run Text="{Binding RepositoryUrl,Mode=OneWay}"/></Hyperlink>
        </TextBlock>
        <Button Grid.Column="1" Content="复制链接" Command="{Binding CopyRepositoryUrlCommand}" AutomationProperties.Name="复制 LightyearXizIl 的 GitHub 仓库链接" VerticalAlignment="Top"/>
      </Grid>
      <TextBlock Text="{Binding RepositoryNotice}" Style="{StaticResource SubtleText}" Margin="0,8,0,0"/>
      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20"/>
      <TextBlock Text="软件更新" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{Binding UpdateNotice}" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <Button Content="{Binding UpdateActionLabel}" Command="{Binding UpdateActionCommand}" ToolTip="{Binding UpdateActionHint}"
              AutomationProperties.Name="{Binding UpdateActionLabel}" AutomationProperties.AutomationId="Update.Action"
              HorizontalAlignment="Left" Margin="0,0,0,8"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
