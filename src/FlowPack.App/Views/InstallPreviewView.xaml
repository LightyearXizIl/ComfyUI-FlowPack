<UserControl x:Class="FlowPack.App.Views.InstallPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Page.InstallPreview">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="28" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <Button Content="← 返回资源包" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Padding="0" HorizontalAlignment="Left" Cursor="Hand" Command="{Binding NavigateCommand}" CommandParameter="Packages" />
        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" Margin="0,10,0,0" />
        <TextBlock Text="{Binding SelectedPackageSubtitle}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Content="开始安装" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" IsEnabled="False" Command="{Binding StartInstallCommand}" ToolTip="选择并检查真实 ComfyUI 环境后才能生成安装计划" />
    </Grid>

    <Border Grid.Row="2">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCard}">
          <Style.Triggers><DataTrigger Binding="{Binding HasSelectedPackage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="尚未选择资源包" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
        <TextBlock Text="请返回资源包列表，选择一个真实导入的清单。" Style="{StaticResource SubtleText}" Margin="0,7,0,18" />
        <Button Content="返回资源包" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Command="{Binding NavigateCommand}" CommandParameter="Packages" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.Style>
        <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedPackage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
      </Grid.Style>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="环境检查" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="●  尚未检查" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="0,14,0,8" />
          <TextBlock Text="当前没有目标实例指纹、Python 路径或资源库信息，FlowPack 不会据此生成安装计划。" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="清单内容" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding SelectedPackageResourceSummary}" Margin="0,14,0,8" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
          <TextBlock Text="这里只展示清单声明；复用、下载、部署和空间结论必须等待真实环境检查。" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="4">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers><DataTrigger Binding="{Binding HasSelectedPackage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <TextBlock Text="资源声明" Style="{StaticResource SectionTitle}" />
        <ItemsControl ItemsSource="{Binding SelectedPackage.Resources}" Margin="0,12,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
