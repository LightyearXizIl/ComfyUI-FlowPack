<UserControl x:Class="FlowPack.App.Views.SecondaryDetailsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AutomationProperties.AutomationId="Secondary.Panel" KeyboardNavigation.TabNavigation="Cycle">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <Border Style="{StaticResource Card}" Padding="0">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,20">
    <DockPanel><Button x:Name="ReturnButton" DockPanel.Dock="Right" Content="关闭" Command="{Binding CloseSecondaryPanelCommand}" Style="{StaticResource StandardActionButton}" ToolTip="关闭详情（Esc）" AutomationProperties.AutomationId="Secondary.Close" VerticalAlignment="Top" Margin="16,0,0,0"/>
     <StackPanel><TextBlock Text="{Binding SecondaryPanelTitle}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding SecondaryPanelSubtitle}" Style="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,6,0,0" ToolTip="{Binding SecondaryPanelSubtitle}"/></StackPanel>
    </DockPanel>
   </Border>
   <TabControl ItemContainerStyle="{StaticResource NavigationTabItem}" Grid.Row="1" SelectedIndex="{Binding InstanceDetailTabIndex}" Margin="24,16,24,0" Visibility="{Binding IsInstanceDetails,Converter={StaticResource Visible}}" AutomationProperties.AutomationId="Secondary.InstanceTabs">
    <TabItem Header="版本信息"><ScrollViewer Style="{StaticResource PageScroll}"><StackPanel Margin="0,16,0,0">
     <TextBlock Text="分别核对磁盘文件与当前运行实例，未确认的信息不会猜测。" Style="{StaticResource SubtleText}" Margin="0,0,0,16"/>
     <ItemsControl ItemsSource="{Binding InstanceVersionFields}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Style="{StaticResource SubtleText}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold"/>
     </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="资源目录"><ScrollViewer Style="{StaticResource PageScroll}" AutomationProperties.AutomationId="Secondary.DirectoryScroll"><StackPanel Margin="0,16,0,0">
     <TextBlock Text="以下路径来自当前实例配置。可打开目录或复制完整路径。" Style="{StaticResource SubtleText}" Margin="0,0,0,4"/>
     <ItemsControl ItemsSource="{Binding InstanceDirectoryRows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14"><StackPanel>
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0"><Button Content="复制" Command="{Binding DataContext.CopySecondaryTextCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path}" Style="{StaticResource StandardActionButton}" Margin="0,0,8,0"/><Button Content="打开" Command="{Binding DataContext.OpenInstanceDirectoryCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource StandardActionButton}"/></StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="{Binding Path}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
     </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="24,16,24,0" Visibility="{Binding IsStatusDetails,Converter={StaticResource Visible}}" AutomationProperties.AutomationId="Secondary.StatusScroll">
    <StackPanel><TextBlock Text="{Binding HomeStatusTitle}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding HomeStatusSummary}" Style="{StaticResource SubtleText}" Margin="0,8,0,4"/>
     <ItemsControl ItemsSource="{Binding HomeStatusDetailGroups}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,24,0,0">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12"><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="22"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12" Margin="0,16,0,0"><DockPanel>
    <Button DockPanel.Dock="Right" Content="复制完整记录" Command="{Binding CopySecondaryTextCommand}" CommandParameter="{Binding HomeStatusDetails}" Style="{StaticResource StandardActionButton}" Visibility="{Binding IsStatusDetails,Converter={StaticResource Visible}}" Margin="16,0,0,0"/>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Esc 关闭" Style="{StaticResource SubtleText}"/><TextBlock Text="{Binding SecondaryPanelNotice}" TextWrapping="Wrap"/></StackPanel>
   </DockPanel></Border>
  </Grid>
 </Border>
</UserControl>
