<UserControl x:Class="FlowPack.App.Views.InstallView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:FlowPack.App.Views" AutomationProperties.AutomationId="Page.Install">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="OnlineVisibility"/></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <Button DockPanel.Dock="Right" Content="选择文件" Command="{Binding ImportNativeCommand}" Margin="16,0,0,0" VerticalAlignment="Top"/>
   <StackPanel><TextBlock Text="导入安装" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="拖入 ZIP、工作流或资源目录，核对内容与依赖后再安装。" Style="{StaticResource SubtleText}" Margin="0,8,0,0"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="1 · 核对导入内容" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
   <ItemsControl ItemsSource="{Binding ImportResources}" IsEnabled="{Binding CoreReady}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel>
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"/>
      <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsSelected,UpdateSourceTrigger=PropertyChanged}">
       <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
      </CheckBox></DockPanel>
     <Expander Header="详情与用途" Margin="22,8,0,0" Foreground="{DynamicResource MutedBrush}"><StackPanel Margin="0,8,0,0">
      <TextBlock Text="{Binding OriginalPath}" TextWrapping="Wrap"/><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Margin="0,6,0,8"/>
      <TextBox Text="{Binding TargetRelativePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="目标相对路径"/>
      <Button Content="确认用途" Command="{Binding DataContext.ConfirmMappingCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
     </StackPanel></Expander>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Visibility="{Binding HasOnlineResources,Converter={StaticResource OnlineVisibility}}" Margin="0,0,0,16">
   <StackPanel><TextBlock Text="2 · 补全清单资源" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
    <TextBlock Text="先核对本地资源，缺失时再下载；补全后加入同一安装预览。" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <Button Content="下载全部已确认项" Command="{Binding DownloadOnlineCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
    <ItemsControl ItemsSource="{Binding OnlineResources}" AutomationProperties.Name="在线清单待补全资源"><ItemsControl.ItemTemplate><DataTemplate>
     <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel>
      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>
      <WrapPanel><Button Content="下载并检查" Command="{Binding DataContext.DownloadOnlineCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
       <Button Content="选择本地文件" Command="{Binding DataContext.ChooseOnlineLocalCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
      <Expander Header="来源与校验" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"><StackPanel>
       <TextBlock Text="{Binding Source}" TextWrapping="Wrap"/><TextBlock Text="{Binding HashNotice}" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <TextBlock Text="文件下载链接（HTTPS）" Margin="0,12,0,4"/>
       <TextBox Text="{Binding SourceUrlDraft,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="文件下载链接" TextWrapping="Wrap"/>
       <Button Content="保存来源" Command="{Binding DataContext.SaveOnlineSourceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding Resource.DeploymentPurpose}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel></Expander>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="3 · 检查工作流依赖" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
   <WrapPanel><Button Content="重新查询来源" Command="{Binding ResolveSourcesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,12"/>
    <Button Content="下载全部已确认项" Command="{Binding DownloadMissingCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12"/></WrapPanel>
   <ItemsControl ItemsSource="{Binding DependencyRows}" IsEnabled="{Binding CoreReady}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel>
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"/>
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/></DockPanel>
     <TextBlock Text="{Binding RequiredBy}" Style="{StaticResource SubtleText}" Margin="0,4,0,8" TextWrapping="Wrap"/>
     <Expander Header="来源与处理" Foreground="{DynamicResource MutedBrush}"><StackPanel Margin="0,8,0,0">
      <TextBlock Text="{Binding SourceNotice}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="模型类别"/><TextBox Text="{Binding Category,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模型类别" Margin="0,4,0,8"/>
      <TextBlock Text="文件直链或节点仓库"/><TextBox Text="{Binding DownloadUrl,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="下载来源" Margin="0,4,0,8"/>
      <TextBlock Text="来源 SHA-256（可选）"/><TextBox Text="{Binding ExpectedSha256,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="来源哈希" Margin="0,4,0,8"/>
      <WrapPanel><Button Content="下载" Command="{Binding DataContext.DownloadMissingCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
       <Button Content="选择本地文件" Command="{Binding DataContext.ChooseLocalDependencyCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
     </StackPanel></Expander>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
  <Expander Header="安装计划详情" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"><StackPanel Margin="0,12,0,0">

   <DataGrid ItemsSource="{Binding DeploymentFiles}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="320"><DataGrid.Columns>
    <DataGridTextColumn Header="实际目标路径" Binding="{Binding TargetPath}" Width="*"/><DataGridCheckBoxColumn Header="复用" Binding="{Binding Reuse}" Width="65"/><DataGridTextColumn Header="字节" Binding="{Binding SizeBytes}" Width="110"/>
   </DataGrid.Columns></DataGrid>
  </StackPanel></Expander>
  <Expander Header="已有包与旧清单" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"><StackPanel>
   <views:PackagesView Margin="0,12,0,0"/>
   <views:InstallPreviewView Margin="0,20,0,0" Visibility="{Binding HasSelectedPackage,Converter={StaticResource OnlineVisibility}}"/>
  </StackPanel></Expander>
   </StackPanel></ScrollViewer>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="4 · 确认安装" Style="{StaticResource StepLabel}"/>
     <TextBlock Text="目标实例" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="{Binding SelectedInstance.DisplayName,TargetNullValue=尚未选择实例,FallbackValue=尚未选择实例}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock Text="在窗口右上方切换目标实例。" Style="{StaticResource SubtleText}" Margin="0,6,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}"><StackPanel>
     <TextBlock Text="计划摘要" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding DeploymentSummary}" TextWrapping="Wrap"/>
     <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12" Margin="0,16,0,16">
      <TextBlock Text="{Binding DeploymentGateNotice}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
     </Border>
     <TextBlock Text="{Binding CoreNotice}" Style="{StaticResource SubtleText}"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
     <Button Content="重新检查计划" Command="{Binding PreviewDeploymentCommand}" Margin="0,0,0,8"/>
     <Button Content="安装" Command="{Binding ExecuteDeploymentCommand}" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
