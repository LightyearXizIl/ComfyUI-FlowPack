<UserControl x:Class="FlowPack.App.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Page.Packages">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="已有包与旧清单" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="兼容已有的清单和展开目录；下载与安装仍需核对环境。" Style="{StaticResource SubtleText}" Margin="0,8,0,12"/>
      <WrapPanel><Button Content="导入资源包文件" Command="{Binding ImportPackageCommand}" Margin="0,0,8,8"/>
        <Button Content="导入已展开目录" Command="{Binding ImportPackageFolderCommand}" Margin="0,0,0,8"/></WrapPanel>
    </StackPanel>
    <TextBox Grid.Row="4" Text="{Binding PackageSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称、版本或状态搜索资源包" AutomationProperties.Name="搜索资源包" />
    <Grid Grid.Row="6">
      <Border>
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCard}">
            <Style.Triggers><DataTrigger Binding="{Binding HasPackages}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="还没有资源包" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
          <TextBlock Text="导入已校验的清单、.cpack 或已展开目录后，它会保存到当前资源库。" Style="{StaticResource SubtleText}" Margin="0,7,0,18" TextAlignment="Center" />
          <WrapPanel HorizontalAlignment="Center">
            <Button Content="导入文件" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Command="{Binding ImportPackageCommand}" />
            <Button Content="导入目录" Style="{StaticResource SecondaryButton}" Command="{Binding ImportPackageFolderCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding PackageView}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" /></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                  <TextBlock Text="◆" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource SubtleText}" Margin="10,3,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource StatusBadge}" VerticalAlignment="Center" Margin="14,0">
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="3" Content="查看详情" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                        Command="{Binding DataContext.OpenPackageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>
