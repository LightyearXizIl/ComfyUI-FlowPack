<UserControl x:Class="FlowPack.App.Views.WorkflowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Page.Workflows">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Content="导入工作流" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Command="{Binding ImportWorkflowCommand}" />
    </Grid>
    <TextBox Grid.Row="2" Text="{Binding WorkflowSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称、格式或说明搜索工作流" AutomationProperties.Name="搜索工作流" />
    <Grid Grid.Row="4">
      <Border>
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCard}">
            <Style.Triggers><DataTrigger Binding="{Binding HasWorkflows}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="还没有工作流" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
          <TextBlock Text="选择资源库后导入 JSON；FlowPack 会保留原始内容与未知字段。" Style="{StaticResource SubtleText}" Margin="0,7,0,18" TextWrapping="Wrap" />
          <Button Content="导入工作流" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Command="{Binding ImportWorkflowCommand}" />
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding WorkflowView}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                  <Border Style="{StaticResource StatusBadge}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Format}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>
