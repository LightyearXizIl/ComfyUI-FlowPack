<UserControl x:Class="FlowPack.App.Views.WorkflowsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.AutomationId="Page.Workflows">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <Button DockPanel.Dock="Right" Content="导出勾选资源" Command="{Binding PreviewZipCommand}" CommandParameter="Workflow" Style="{StaticResource PrimaryButton}" Margin="12,0,0,8" VerticalAlignment="Top"/>
   <WrapPanel>
    <Button Content="扫描实例" Command="{Binding RefreshInstancesCommand}" Margin="0,0,8,8"/>
    <Button Content="导入文件" Command="{Binding ImportNativeCommand}" Margin="0,0,12,8"/>
    <CheckBox Content="包含工作流依赖" IsChecked="{Binding IncludeDependencies}" VerticalAlignment="Center" Margin="0,0,12,8"/>
   </WrapPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <DataGrid ItemsSource="{Binding LocalWorkflowsView}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" MinHeight="100"><DataGrid.Columns>
    <DataGridTemplateColumn Header="选择" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" Padding="8"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="名称" Binding="{Binding Name}" IsReadOnly="True" Width="2*" MinWidth="160"/>
    <DataGridTextColumn Header="类别" Binding="{Binding Category}" IsReadOnly="True" Width="110"/>
    <DataGridTextColumn Header="实际位置" Binding="{Binding Path}" IsReadOnly="True" Width="3*" MinWidth="140"/>
   </DataGrid.Columns></DataGrid>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="360" Margin="24,48,24,12">
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LocalWorkflowsView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="没有可显示的工作流" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
    <TextBlock Text="请选择实例并扫描，或清空搜索。" Style="{StaticResource SubtleText}" TextAlignment="Center" Margin="0,8,0,0"/>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
