<UserControl x:Class="FlowPack.App.Views.TasksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.AutomationId="Page.Tasks">
  <UserControl.Resources>
    <Style x:Key="TaskAction" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="后台任务" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="关闭面板不会停止任务。" Style="{StaticResource SubtleText}"/>
      <Button Content="刷新任务" Command="{Binding RefreshCoreTasksCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,12"/>
      <TextBlock Text="暂无任务">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CoreTasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding CoreTasks}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
              <Setter Property="Text" Value="{Binding State}"/><Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Queued"><Setter Property="Text" Value="等待执行"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Text" Value="正在执行"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Completed"><Setter Property="Text" Value="已完成"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Text" Value="执行失败"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Paused"><Setter Property="Text" Value="已暂停"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter Property="Text" Value="已取消"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="PauseRequested"><Setter Property="Text" Value="正在安全暂停"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="CancelRequested"><Setter Property="Text" Value="正在安全取消"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NeedsReview"><Setter Property="Text" Value="需要重新检查"/></DataTrigger>
              </Style.Triggers></Style></TextBlock.Style></TextBlock>
            <ProgressBar Minimum="0" Maximum="{Binding TotalBytes, TargetNullValue=1}" Value="{Binding CompletedBytes, TargetNullValue=0}" Height="4" Margin="0,10,0,0" AutomationProperties.Name="任务字节进度">
              <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{DynamicResource BorderBrush}"><Border x:Name="PART_Indicator" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/></Grid></ControlTemplate></ProgressBar.Template>
              <ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding TotalBytes}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="任务失败原因"/>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="暂停" Command="{Binding DataContext.PauseCoreTaskCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource TaskAction}"/>
              <Button Content="继续" Command="{Binding DataContext.ResumeCoreTaskCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource TaskAction}"/>
              <Button Content="取消" Command="{Binding DataContext.CancelCoreTaskCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource TaskAction}"/>
              <Button Content="重试" Command="{Binding DataContext.RetryCoreTaskCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource TaskAction}"/>
            </WrapPanel>
            <Expander Header="任务详情"><StackPanel>
              <TextBlock Text="{Binding Operation}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Id}" Style="{StaticResource SubtleText}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding CreatedAt}" Style="{StaticResource SubtleText}"/>
            </StackPanel></Expander>
          </StackPanel>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding CoreNotice}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </Grid>
</UserControl>
