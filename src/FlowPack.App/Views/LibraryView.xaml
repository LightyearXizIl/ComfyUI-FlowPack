<UserControl x:Class="FlowPack.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowPack.App.Views"
             AutomationProperties.AutomationId="Page.Library">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
    </StackPanel>
    <TabControl Grid.Row="2" AutomationProperties.Name="资源库分类">
      <TabItem Header="工作流"><views:WorkflowsView /></TabItem>
      <TabItem Header="模型"><views:ModelsView /></TabItem>
      <TabItem Header="节点"><views:NodesView /></TabItem>
    </TabControl>
  </Grid>
</UserControl>
