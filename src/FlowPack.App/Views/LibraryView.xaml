<UserControl x:Class="FlowPack.App.Views.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FlowPack.App.Views" AutomationProperties.AutomationId="Page.Library">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <Grid DockPanel.Dock="Right" Width="230" Height="38" VerticalAlignment="Center"><TextBox Text="{Binding ResourceFilter,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索名称、类别或路径" AutomationProperties.Name="搜索资源"/>
    <TextBlock Text="搜索资源" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ResourceFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <StackPanel><TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="点击名称查看详情；勾选要导出的资源。" Style="{StaticResource SubtleText}" Margin="0,8,0,0"/>
   </StackPanel>
  </DockPanel>
  <TabControl Grid.Row="1" AutomationProperties.Name="资源库分类" Padding="16" SelectedIndex="{Binding LibraryTabIndex,Mode=TwoWay}">
   <TabControl.Template><ControlTemplate TargetType="TabControl">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="{TemplateBinding Padding}" Margin="0,8,0,0">
      <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
     </Border>
    </Grid>
   </ControlTemplate></TabControl.Template>
   <TabItem Header="工作流"><views:WorkflowsView/></TabItem>
   <TabItem Header="模型"><views:ModelsView/></TabItem>
   <TabItem Header="节点"><views:NodesView/></TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="True" AutomationProperties.AutomationId="Library.Selection">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
    <Button Content="清空选择" Command="{Binding ClearExportSelectionCommand}" Margin="0,0,8,0"/>
    <Button Content="导出所选" Command="{Binding BeginExportCommand}" CommandParameter="Selected" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="Library.Export"/>
   </StackPanel>
   <TextBlock Text="{Binding ExportSelectionSummary}" Style="{StaticResource SubtleText}" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</UserControl>
