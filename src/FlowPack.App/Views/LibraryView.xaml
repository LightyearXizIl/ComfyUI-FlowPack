<UserControl x:Class="FlowPack.App.Views.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FlowPack.App.Views" AutomationProperties.AutomationId="Page.Library">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="按类别查找资源，勾选后导出；文件夹入口指向当前实例。" Style="{StaticResource SubtleText}" Margin="0,8,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource SectionCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="搜索资源" Style="{StaticResource StepLabel}"/>
    <TextBox Text="{Binding ResourceFilter,UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称、类别或路径筛选；隐藏项目保留勾选" AutomationProperties.Name="筛选本地资源"/>
   </StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="当前实例的资源目录" Style="{StaticResource StepLabel}"/><views:FolderShortcutsView ShowLabel="False"/></StackPanel>
  </Grid></Border>
  <TabControl Grid.Row="2" AutomationProperties.Name="资源库分类" Padding="16" SelectedIndex="{Binding LibraryTabIndex,Mode=TwoWay}">
   <TabItem Header="工作流"><views:WorkflowsView/></TabItem>
   <TabItem Header="模型"><views:ModelsView/></TabItem>
   <TabItem Header="节点"><views:NodesView/></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" Text="{Binding CoreNotice}" Style="{StaticResource SubtleText}" Margin="0,12,0,0"/>
 </Grid>
</UserControl>
