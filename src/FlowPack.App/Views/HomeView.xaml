<UserControl x:Class="FlowPack.App.Views.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:FlowPack.App.Views" AutomationProperties.AutomationId="Page.Home">
 <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
  <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
  <TextBlock Text="管理所选实例的资源，或导入资源包检查并安装。" Style="{StaticResource SubtleText}" Margin="0,8,0,24"/>
  <Border Style="{StaticResource SectionCard}"><StackPanel>
   <TextBlock Text="当前 Desktop 实例" Style="{StaticResource StepLabel}"/>
   <DockPanel Margin="0,0,0,12">
    <WrapPanel DockPanel.Dock="Right" Margin="16,0,0,0">
     <Button Content="重新检测与扫描" Command="{Binding RefreshInstancesCommand}" Margin="0,0,8,8"/>
     <Button Content="手动关联目录" Command="{Binding AssociateInstanceCommand}" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock Text="{Binding SelectedInstance.DisplayName,TargetNullValue=尚未选择实例,FallbackValue=尚未选择实例}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </DockPanel>
   <views:FolderShortcutsView/>
   <Expander Header="查看安装位置与资源目录" Margin="0,4,0,0">
    <TextBlock Text="{Binding InstancePaths}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </Expander>
  </StackPanel></Border>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="导入与安装" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="拖入 ZIP、工作流或目录，核对资源用途和缺失依赖，再检查安装计划。" Style="{StaticResource SubtleText}" Margin="0,8,0,20"/>
    <Button Content="导入 ZIP / 工作流" Command="{Binding ImportNativeCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
   </StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="管理与分享" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="查看工作流、模型和节点。勾选要分享的资源，核对导出预览后保存 ZIP。" Style="{StaticResource SubtleText}" Margin="0,8,0,20"/>
    <Button Content="选择资源并打包" Command="{Binding NavigateCommand}" CommandParameter="Library" HorizontalAlignment="Left"/>
   </StackPanel></Border>
  </Grid>
  <Border Style="{StaticResource Card}"><StackPanel>
   <DockPanel><Button DockPanel.Dock="Right" Content="查看后台任务" Command="{Binding NavigateCommand}" CommandParameter="Tasks" Margin="16,0,0,0"/>
    <StackPanel><TextBlock Text="当前状态" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="{Binding CoreNotice}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
   </DockPanel>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
