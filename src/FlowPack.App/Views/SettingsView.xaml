<UserControl x:Class="FlowPack.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FlowPack.App.Views" AutomationProperties.AutomationId="Page.Settings">
 <ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
  <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
  <TextBlock Text="外观和语言即时生效；实例、更新与高级选项按用途分组。" Style="{StaticResource SubtleText}" Margin="0,8,0,24"/>
  <Border Style="{StaticResource SectionCard}"><StackPanel>
   <TextBlock Text="界面偏好" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="外观" FontWeight="SemiBold"/><TextBlock Text="跟随系统或手动选择" Style="{StaticResource SubtleText}"/></StackPanel>
    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeBaseOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedThemeBase,Mode=TwoWay}" AutomationProperties.Name="主题基底模式" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"/>
    <TextBlock Grid.Row="2" Text="{Binding Text[Settings.Language]}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedLanguage,Mode=TwoWay}" AutomationProperties.Name="{Binding Text[Settings.Language]}" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"/>
   </Grid>
  </StackPanel></Border>
  <Border Style="{StaticResource SectionCard}"><StackPanel>
   <TextBlock Text="Desktop 实例" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="{Binding SelectedInstance.DisplayName,TargetNullValue=尚未选择实例,FallbackValue=尚未选择实例}" Margin="0,8,0,12" TextWrapping="Wrap"/>
   <WrapPanel><Button Content="重新检测" Command="{Binding RefreshInstancesCommand}" Margin="0,0,8,8"/><Button Content="手动关联" Command="{Binding AssociateInstanceCommand}" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock Text="多个实例可在窗口右上方切换；关联不会移动原有资源。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <Border Style="{StaticResource SectionCard}"><StackPanel>
   <TextBlock Text="{Binding Text[Settings.Update]}" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="{Binding UpdateNotice}" Margin="0,8,0,12" TextWrapping="Wrap"/>
   <WrapPanel><Button Content="{Binding Text[Update.Check]}" Command="{Binding CheckForUpdatesCommand}" AutomationProperties.Name="{Binding Text[Update.Check]}" Margin="0,0,8,8"/>
    <Button Content="下载并安装更新" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding HasUpdate}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><Expander Header="高级设置与自定义外观"><views:AppearanceView Margin="0,16,0,0"/></Expander></Border>
 </StackPanel></ScrollViewer>
</UserControl>
