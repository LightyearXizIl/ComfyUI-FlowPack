<UserControl x:Class="FlowPack.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowPack.App.Views"
             AutomationProperties.AutomationId="Page.Settings">
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Text[Settings.Language]}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding LanguageOptions}"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Text[Settings.Language]}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="{Binding Text[Settings.Update]}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{Binding UpdateNotice}" Margin="0,8,0,12" TextWrapping="Wrap" />
        <Button Content="{Binding Text[Update.Check]}" Command="{Binding CheckForUpdatesCommand}" AutomationProperties.Name="{Binding Text[Update.Check]}" />
      </StackPanel>
    </Border>
    <views:AppearanceView />
  </StackPanel>
</UserControl>
