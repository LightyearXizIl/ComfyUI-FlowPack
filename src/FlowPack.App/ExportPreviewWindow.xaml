<Window x:Class="FlowPack.App.ExportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出 ZIP · FlowPack" Width="880" Height="640" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="ExportPreview.Window">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="导出 ZIP" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="确认资源与缺失项，保存后即可分享。关闭窗口不会清空资源选择。" Style="{StaticResource SubtleText}" Margin="0,8,0,16"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource SectionCard}"><StackPanel>
      <WrapPanel>
        <CheckBox Content="关联工作流依赖" IsChecked="{Binding IncludeDependencies}" IsEnabled="{Binding CoreReady}" Margin="0,0,20,12"/>
        <CheckBox Content="允许带缺失说明导出" IsChecked="{Binding AllowPartialExport}" IsEnabled="{Binding CoreReady}" Margin="0,0,0,12"/>
      </WrapPanel>
      <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"><TextBlock Text="{Binding ExportSummary}" TextWrapping="Wrap"/></ScrollViewer>
    </StackPanel></Border>
    <DataGrid Grid.Row="2" x:Name="ExportFileList" ItemsSource="{Binding ExportFiles}" AutoGenerateColumns="False"
              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" AutomationProperties.Name="导出文件列表">
      <DataGrid.Columns>
        <DataGridTextColumn Header="包内路径" Binding="{Binding ArchivePath}" Width="*" MinWidth="340"/>
        <DataGridTextColumn Header="大小（字节）" Binding="{Binding SizeBytes, StringFormat=N0}" Width="135"/>
      </DataGrid.Columns>
    </DataGrid>
    <Expander Grid.Row="3" Header="所选文件详情" Margin="0,12,0,0">
      <StackPanel Margin="0,8,0,8">
        <TextBlock Text="{Binding SelectedItem.SourcePath, ElementName=ExportFileList}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding SelectedItem.Sha256, ElementName=ExportFileList, StringFormat=SHA-256：{0}}" Style="{StaticResource SubtleText}" TextWrapping="Wrap"/>
      </StackPanel>
    </Expander>
    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding CoreNotice}" TextWrapping="Wrap" Style="{StaticResource SubtleText}" Margin="0,0,0,12"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="关闭" IsCancel="True" Click="ClosePreview" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
        <Button Content="更新预览" Command="{Binding PreviewZipCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
        <Button Content="保存 ZIP" Command="{Binding SaveZipCommand}" Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
